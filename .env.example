# Copy to .env and adjust. Every variable is optional in development,
# except GEMINI_API_KEY for `support-crm chat`.

# --- Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Any free-tier model ID, e.g. gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash
SUPPORT_AGENT_LLM_TEMPERATURE=0.2
SUPPORT_AGENT_LLM_TIMEOUT_SECONDS=30
SUPPORT_AGENT_LLM_MAX_RETRIES=3

# --- Agent guardrails
SUPPORT_AGENT_AGENT_MAX_LLM_ROUNDS=6
SUPPORT_AGENT_AGENT_MAX_TOOL_CALLS_PER_TURN=8
SUPPORT_AGENT_AGENT_APPROVAL_TTL_MINUTES=10
# Refunds always need approval; this controls ticket creation.
SUPPORT_AGENT_AGENT_REQUIRE_TICKET_APPROVAL=true

# --- Phase 3: LangGraph workflows
# Checkpoint file for saved conversations and pending approvals.
# Default: checkpoints.db next to the CRM database (data/checkpoints.db).
# SUPPORT_AGENT_CHECKPOINT_DB_PATH=data/checkpoints.db
# Bounded retries for transient database errors inside workflow steps.
SUPPORT_AGENT_WORKFLOW_MAX_RETRIES=3
SUPPORT_AGENT_WORKFLOW_RETRY_BASE_DELAY_SECONDS=0.2
SUPPORT_AGENT_STAFF_SESSION_TTL_MINUTES=60


# development | test | production  (production refuses the default secret)
SUPPORT_AGENT_ENVIRONMENT=development

# SQLAlchemy URL. Relative SQLite paths are resolved from the current directory.
SUPPORT_AGENT_DATABASE_URL=sqlite:///data/crm.db

# Logging: DEBUG | INFO | WARNING | ERROR, format: text | json
SUPPORT_AGENT_LOG_LEVEL=INFO
SUPPORT_AGENT_LOG_FORMAT=text

# Secret used to sign customer sessions (HMAC-SHA256). Must be >= 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SUPPORT_AGENT_AUTH_SECRET_KEY=change-me-to-a-long-random-string-of-48-chars

# How long a verified customer session stays valid.
SUPPORT_AGENT_SESSION_TTL_MINUTES=30

# PBKDF2 iterations used when hashing customer PINs at seed time.
SUPPORT_AGENT_PIN_HASH_ITERATIONS=600000

# --- Phase 4: API and Streamlit apps
# Where the Streamlit apps find the FastAPI backend.
SUPPORT_AGENT_API_URL=http://127.0.0.1:8000
