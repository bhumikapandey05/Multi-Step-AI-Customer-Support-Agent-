{
  "description": "dev scenarios. See support_agent/evals/scenario.py for the format.",
  "scenarios": [
    {
      "id": "track-list-orders",
      "category": "order_tracking",
      "title": "Customer asks which orders they have",
      "customer": "alice.nguyen@example.com",
      "turns": [
        {
          "say": "What orders do I have with you?"
        }
      ],
      "expect": {
        "tools_called": [
          "list_orders"
        ],
        "tools_not_called": [
          "request_refund",
          "create_support_ticket"
        ],
        "writes": {
          "refund_requests": 0,
          "tickets": 0
        },
        "reply_contains_any": [
          "ORD-10001"
        ],
        "final_stop_reason": "completed"
      },
      "mock": [
        {
          "calls": [
            {
              "tool": "list_orders",
              "args": {}
            }
          ]
        },
        {
          "text": "You have three orders: ORD-10001 (delivered), ORD-10002 (delivered) and ORD-10003 (shipped)."
        }
      ]
    },
    {
      "id": "track-shipped-order",
      "category": "order_tracking",
      "title": "Where is my coffee set (shipped, not delivered)?",
      "customer": "alice.nguyen@example.com",
      "turns": [
        {
          "say": "Where is my order ORD-10003? It hasn't arrived."
        }
      ],
      "expect": {
        "tools_called": [
          "get_order_details"
        ],
        "reply_contains_any": [
          "shipped"
        ],
        "writes": {
          "refund_requests": 0,
          "tickets": 0
        }
      },
      "mock": [
        {
          "calls": [
            {
              "tool": "get_order_details",
              "args": {
                "order_number": "ORD-10003"
              }
            }
          ]
        },
        {
          "text": "ORD-10003 has shipped and is on its way. It hasn't been delivered yet."
        }
      ]
    },
    {
      "id": "track-typo-self-correct",
      "category": "order_tracking",
      "title": "Model sends a malformed order number, then corrects it",
      "customer": "alice.nguyen@example.com",
      "turns": [
        {
          "say": "status of order 10003?"
        }
      ],
      "expect": {
        "tool_errors": {
          "get_order_details": "invalid_arguments"
        },
        "tools_called": [
          "get_order_details"
        ],
        "final_stop_reason": "completed"
      },
      "mock": [
        {
          "calls": [
            {
              "tool": "get_order_details",
              "args": {
                "order_number": "10003"
              }
            }
          ]
        },
        {
          "calls": [
            {
              "tool": "get_order_details",
              "args": {
                "order_number": "ORD-10003"
              }
            }
          ]
        },
        {
          "text": "ORD-10003 has shipped."
        }
      ]
    },
