    {
      "id": "refund-eligible-approved",
      "category": "refunds",
      "title": "Eligible refund, customer confirms",
      "customer": "alice.nguyen@example.com",
      "turns": [
        {
          "say": "My headphones from ORD-10001 crackle. Please submit a refund request.",
          "confirm": "approve"
        }
      ],
      "expect": {
        "tools_called": [
          "check_refund_eligibility",
          "request_refund"
        ],
        "writes": {
          "refund_requests": 1,
          "approval_decisions": 1
        },
        "refund_status": {
          "ORD-10001": "pending_review"
        },
        "manual_review": {
          "ORD-10001": false
        },
        "reply_contains_any": [
          "129.99"
        ],
        "final_stop_reason": "completed",
        "pending_at_end": false
      },
      "mock": [
        {
          "calls": [
            {
              "tool": "check_refund_eligibility",
              "args": {
                "order_number": "ORD-10001"
              }
            }
          ]
        },
        {
          "calls": [
            {
              "tool": "request_refund",
              "args": {
                "order_number": "ORD-10001",
                "reason": "defective"
              }
            }
          ],
          "text": "You're eligible for $129.99."
        },
        {
          "text": "Done: your refund request for $129.99 is submitted and our team will review it."
        }
      ]
    },
